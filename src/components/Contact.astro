---
---
<section class="contact" id="contact" data-dark>
  <div class="wrap">
    <div class="contact-head rv">
      <span class="mono">04 / 联系</span>
    </div>

    <div class="contact-grid">
      <h2 class="contact-title rv">
        有项目想聊，<br />随时找我。
      </h2>

      <div class="contact-side rv" style="--d:.1s">
        <p class="contact-note">
          我一般会问清楚三件事：要解决什么问题、什么时候要、有没有历史包袱。
          想清楚这三点，剩下的都好谈。
        </p>

        <div class="mail" data-mail>
          <button class="mail-btn" type="button" data-mail-toggle aria-expanded="false">
            <span class="mail-label">邮件联系</span>
            <span class="mail-ico" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 3.5h12v7H1z" stroke="currentColor" stroke-width="1.2"/>
                <path d="m1 4 6 4.2L13 4" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            </span>
          </button>

          <div class="mail-reveal" data-mail-reveal>
            <div class="mail-out" data-mail-out>
              <span class="mail-addr mono" data-mail-addr aria-live="polite"></span>
              <button class="mail-copy mono" type="button" data-mail-copy tabindex="-1">复制</button>
            </div>
          </div>
          <noscript>
            <p class="mail-addr mono mail-addr-static">yangmarker26<span aria-hidden="true"> [at] </span>gmail.com</p>
          </noscript>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Email is assembled at runtime so scrapers get nothing from the HTML.
  const parts = ['yangmarker26', 'gmail', 'com'];
  const mail = `${parts[0]}@${parts[1]}.${parts[2]}`;

  document.querySelectorAll<HTMLElement>('[data-mail]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-mail-toggle]');
    const out = root.querySelector<HTMLElement>('[data-mail-out]');
    const addr = root.querySelector<HTMLElement>('[data-mail-addr]');
    const copy = root.querySelector<HTMLButtonElement>('[data-mail-copy]');
    if (!toggle || !out || !addr || !copy) return;

    const reveal = root.querySelector<HTMLElement>('[data-mail-reveal]');
    if (!reveal) return;

    toggle.addEventListener('click', () => {
      const open = !reveal.classList.contains('open');
      reveal.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      copy.tabIndex = open ? 0 : -1;
      addr.textContent = mail;
    });

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(mail);
        copy.textContent = '已复制';
      } catch {
        // Fallback: select the text so the user can copy manually.
        const r = document.createRange();
        r.selectNodeContents(addr);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(r);
        copy.textContent = '请按 Ctrl+C';
      }
      setTimeout(() => (copy.textContent = '复制'), 1800);
    });
  });
</script>

<style>
  .contact {
    padding-block: clamp(5rem, 11vw, 9rem);
    background: var(--ink-950);
    color: var(--on-ink);
    position: relative;
    overflow: hidden;
  }
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      70% 60% at 80% 20%,
      rgba(194, 35, 63, 0.13) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .contact-head {
    color: var(--on-ink-muted);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    position: relative;
  }
  .contact-title {
    font-size: clamp(2.1rem, 5.6vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .contact-note {
    color: var(--on-ink-muted);
    font-size: 0.95rem;
    line-height: 1.85;
    max-width: 40ch;
    margin-bottom: 1.9rem;
  }

  .mail {
    position: relative;
    border-top: 1px solid var(--on-ink-line);
    padding-top: 1.1rem;
  }
  .mail-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1rem;
    font-weight: 500;
    padding: 0;
    color: var(--on-ink);
  }
  .mail-ico {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--on-ink-line);
    border-radius: 50%;
    transition: background-color var(--t-base) var(--ease-soft),
      border-color var(--t-base) var(--ease-soft),
      transform var(--t-base) var(--ease);
  }
  .mail-btn:hover .mail-ico {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .mail-btn:hover .mail-label {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(243, 240, 232, 0.4);
  }

  /* Height + opacity both transition, so the address unfolds instead of
     popping into place. 0fr -> 1fr animates grid tracks, which needs no
     magic max-height number. */
  .mail-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.5s var(--ease),
      opacity 0.45s var(--ease), margin-top 0.5s var(--ease);
    margin-top: 0;
  }
  .mail-reveal.open {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 1rem;
  }
  .mail-reveal > * {
    overflow: hidden;
    min-height: 0;
  }

  .mail-out {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    transform: translateY(-6px);
    transition: transform var(--t-slow) var(--ease);
  }
  .mail-reveal.open .mail-out {
    transform: none;
  }
  .mail-addr {
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--on-ink);
    border-bottom: 1px dashed rgba(243, 240, 232, 0.28);
    padding-bottom: 2px;
  }
  .mail-addr-static {
    margin-top: 1rem;
    display: inline-block;
  }
  .mail-copy {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--on-ink-muted);
    border: 1px solid var(--on-ink-line);
    padding: 0.3rem 0.55rem;
    border-radius: 2px;
    transition: color var(--t-base) var(--ease-soft),
      border-color var(--t-base) var(--ease-soft),
      background-color var(--t-base) var(--ease-soft);
  }
  .mail-copy:hover {
    color: var(--on-ink);
    border-color: rgba(243, 240, 232, 0.5);
  }


  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 2.25rem;
    }
  }
</style>
