---
---

<section class="hero" id="top" data-hero data-dark>
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <div class="hero-meta">
      <span class="mono">全栈工程师</span>
      <span class="hero-dot" aria-hidden="true"></span>
      <span class="mono">2018 — 至今</span>
    </div>

    <h1 class="hero-title">
      <span class="hl"><span>把系统从 0</span></span>
      <span class="hl"><span>做到上线，</span></span>
      <span class="hl"><span>也把它做到<em>不卡</em>。</span></span>
    </h1>

    <p class="hero-sub">
      杨天。八年前端与全栈开发，做过企业级低代码平台、跨境业务的数据自动化，
      也把一个海外的品牌站从 4 秒的加载压到 1.9 秒。
    </p>

    <div class="hero-cta">
      <a class="btn btn-solid" href="#work">
        <span>看看我做过什么</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M7 1v12M2 8l5 5 5-5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="btn btn-ghost" href="#contact">
        <span>邮件联系</span>
      </a>
    </div>
  </div>

  <div class="hero-rail">
    <div class="wrap">
      <dl class="stats">
        <div class="stat">
          <dt class="mono">年限</dt>
          <dd><span data-count="8">8</span><span class="unit">年</span></dd>
        </div>
        <div class="stat">
          <dt class="mono">从 0 到 1</dt>
          <dd><span data-count="3">3</span><span class="unit">个系统</span></dd>
        </div>
        <div class="stat">
          <dt class="mono">首屏 LCP</dt>
          <dd>4s<span class="arrow">→</span>1.9s</dd>
        </div>
        <div class="stat">
          <dt class="mono">可复用物料</dt>
          <dd><span data-count="20">20</span><span class="unit">+</span></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  import { initHeroCanvas } from '../scripts/hero-net';
  const canvas = document.querySelector('[data-hero-canvas]');
  if (canvas instanceof HTMLCanvasElement) initHeroCanvas(canvas);
</script>

<style>
  .hero {
    position: relative;
    background: var(--ink-950);
    color: var(--on-ink);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 1;
    /* Only the far left is dimmed, so the headline keeps a clean field. */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 18%,
      #000 42%,
      #000 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 18%,
      #000 42%,
      #000 100%
    );
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      90% 70% at 15% 10%,
      rgba(194, 35, 63, 0.14) 0%,
      transparent 60%
    );
  }

  .hero-in {
    position: relative;
    z-index: 2;
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: clamp(9rem, 16vh, 12rem);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--on-ink-muted);
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }
  .hero-meta .mono {
    font-size: 0.7rem;
  }
  .hero-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px 1px rgba(194, 35, 63, 0.7);
  }

  .hero-title {
    font-size: clamp(2.55rem, 7.2vw, 6.1rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 600;
    max-width: 17ch;
  }
  .hero-title em {
    font-style: normal;
    color: var(--accent);
    position: relative;
    white-space: nowrap;
  }
  .hero-title em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.055em;
    background: var(--accent);
    opacity: 0.45;
    transform-origin: left;
    animation: underline-in 1.1s var(--ease) 0.9s both;
  }
  @keyframes underline-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .hl {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .hl > span {
    display: block;
    transform: translateY(105%);
    animation: line-up 1.05s var(--ease) both;
  }
  .hl:nth-child(1) > span {
    animation-delay: 0.08s;
  }
  .hl:nth-child(2) > span {
    animation-delay: 0.18s;
  }
  .hl:nth-child(3) > span {
    animation-delay: 0.28s;
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }

  .hero-sub {
    margin-top: clamp(1.5rem, 3.5vw, 2.35rem);
    max-width: 44ch;
    color: var(--on-ink-muted);
    font-size: clamp(0.95rem, 1.35vw, 1.06rem);
    line-height: 1.85;
    opacity: 0;
    animation: fade-up 1s var(--ease) 0.55s both;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    opacity: 0;
    animation: fade-up 1s var(--ease) 0.7s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.35rem;
    border-radius: 2px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid transparent;
    transition: background-color var(--t-base) var(--ease-soft),
      color var(--t-base) var(--ease-soft),
      border-color var(--t-base) var(--ease-soft),
      transform var(--t-base) var(--ease),
      box-shadow var(--t-base) var(--ease-soft);
  }
  .btn svg {
    transition: transform var(--t-base) var(--ease);
  }
  .btn-solid {
    background: var(--on-ink);
    color: var(--ink-950);
  }
  .btn-solid:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -12px rgba(194, 35, 63, 0.55);
  }
  .btn-solid:hover svg {
    transform: translateY(3px);
  }
  .btn-ghost {
    border-color: var(--on-ink-line);
    color: var(--on-ink);
  }
  .btn-ghost:hover {
    border-color: var(--on-ink);
    background-color: rgba(243, 240, 232, 0.06);
  }

  /* Stats rail */
  .hero-rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    border-top: 1px solid var(--on-ink-line);
    background: linear-gradient(to bottom, rgba(8, 8, 10, 0), rgba(8, 8, 10, 0.65));
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: clamp(1.25rem, 2.6vw, 1.9rem);
    gap: 1rem;
  }
  .stat {
    padding-right: 1rem;
    border-right: 1px solid var(--on-ink-line);
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat dt {
    color: rgba(243, 240, 232, 0.58);
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    margin-bottom: 0.45rem;
  }
  .stat dd {
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .unit {
    font-size: 0.6em;
    color: rgba(243, 240, 232, 0.62);
    margin-left: 0.18em;
    font-weight: 400;
  }
  .arrow {
    color: var(--accent);
    margin-inline: 0.22em;
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .hero-canvas {
      mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 8%,
        #000 20%,
        transparent 30%
      );
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 8%,
        #000 20%,
        transparent 30%
      );
    }
    .hero-in {
      padding-bottom: 12rem;
    }
    .hero-title {
      font-size: clamp(2.1rem, 10vw, 3rem);
      max-width: 100%;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.1rem;
    }
    .stat:nth-child(2n) {
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      padding-bottom: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hl > span,
    .hero-sub,
    .hero-cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero-title em::after {
      animation: none;
    }
  }
</style>
